PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Supabase project URL and service-role key are backend-only. Never put these in VITE_* variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# HiveMQ Cloud or another MQTT broker. For local broker, use mqtt://localhost:1883.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=elderly/fall/test
DEVICE_ID=esp32_demo_01
DEVICE_OFFLINE_AFTER_SECONDS=45
